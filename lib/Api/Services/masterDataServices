import 'package:http/http.dart' as http;
import 'dart:convert';
import 'package:presale/Api/Helper/appDatabase.dart';

import 'package:presale/Api/ApiEndPoints/apiEndPoints.dart';
import 'package:presale/Api/Helper/constant.dart';
import 'package:presale/Api/Model/vertical_model.dart';
import 'package:presale/Api/Model/dealer_employe_model.dart'; 
import 'package:presale/Api/Model/ccustomer_type_model.dart';  
import 'package:presale/Api/Model/segment_model.dart';
import 'package:presale/Api/Model/source_model.dart';
import 'package:presale/Api/Model/communication_mode_model.dart';
import 'package:presale/Api/Model/ownershipTypeModel.dart';
import 'package:presale/Api/Model/competitor_model.dart';


class MasterDataService {
  static Future<void> syncAllMasterData() async {
  final db = AppDatabase(); // Centralized database helper

  final List<String> refKeywords = [
    'Vertical',
    'Segment',
    'SubSegment',
    'DealBy',
    'ENQUIRYSOURCE',
    'CustomerType',
    'ENQUIRYMODE'
    'COMPETITORNAMEFORMARKETSHARE'
    // Add more as needed
  ];

  for (var refKeyword in refKeywords) {
    final data = await fetchMasterData(refKeyword);
    print("Synced $refKeyword: ${data.length} items");

    if (refKeyword == 'Vertical' && data.isNotEmpty) {
      final verticalList = data.map((json) => VerticalModel.fromJson(json)).toList();
      await db.clearVerticals();
      await db.insertAllVerticals(verticalList);
      print("${verticalList.length} verticals saved to local DB");
    }

    if (refKeyword == 'Segment' && data.isNotEmpty) {
      final segmentList = data.map((json) => SegmentModel.fromJson(json)).toList();
      await db.clearSegments();
      await db.insertAllSegments(segmentList);
      print("${segmentList.length} segments saved to local DB");
    }

    if (refKeyword == 'ENQUIRYSOURCE' && data.isNotEmpty) {
      final sourceList = data.map((json) => SourceModel.fromJson(json)).toList();
      await db.clearSources();
      await db.insertAllSources(sourceList);
      print("${sourceList.length} sources saved to local DB");
    }

    if (refKeyword == 'DealBy' && data.isNotEmpty) {
      final dealByList = data.map((json) => DealByModel.fromJson(json)).toList();
      await db.clearDealBy();
      await db.insertAllDealBy(dealByList);
      print("${dealByList.length} DealBy items saved to local DB");
    }

    if (refKeyword == 'CustomerType' && data.isNotEmpty) {
      final customerTypeList = data.map((json) => CustomerTypeModel.fromJson(json)).toList();
      await db.clearCustomerTypes();
      await db.insertAllCustomerTypes(customerTypeList);
      print("${customerTypeList.length} CustomerTypes saved to local DB");
    }

    if (refKeyword == 'ENQUIRYMODE' && data.isNotEmpty) {
      final communicationModeList = data.map((json) => CommunicationModeModel.fromJson(json)).toList();
      await db.clearCommunicationModes();
      await db.insertAllCommunicationModes(communicationModeList);
      print("${communicationModeList.length} EnquiryMode saved to local DB");
    }


    if (refKeyword == 'DGOWNERSHIP' && data.isNotEmpty) {
      final typeofOwnershipList = data.map((json) => DGOwnershipModel.fromJson(json)).toList();
      await db.clearDGOwnerships();
      await db.insertAllDGOwnerships(typeofOwnershipList);
      print("${typeofOwnershipList.length} typeofOwnership saved to local DB");
    }


    if (refKeyword == 'COMPETITORNAMEFORMARKETSHARE' && data.isNotEmpty) {
      final competitorList = data.map((json) => competitorModel.fromJson(json)).toList();
      await db.clearCompetitors();
      await db.insertAllCompetitors(competitorList);
      print("${competitorList.length} Competitors saved to local DB");
    }
  }
}
  static Future<List<Map<String, dynamic>>> fetchMasterData(String refKeyword) async {
    final url = Uri.parse(ApiEndPoints.getAllMasterData);

    final body = {
      "refKeyword": refKeyword,
      "isActive": 1,
      "id": 0,
      "pinCodeID": 0,
      "transSMSID": 0,
      "smsTo": "string",
      "smsBody": "string",
      "createdBy": "string",
      "createdDate": DateTime.now().toIso8601String(),
      "modifiedBy": "string",
      "modifiedDate": DateTime.now().toIso8601String(),
      "action": "string",
      "result": 0
    };

    try {
      final response = await http.post(
        url,
        headers: {
          "accept": "text/plain",
          "Content-Type": "application/json",
        },
        body: jsonEncode(body),
      );

      if (response.statusCode == 200) {
        final result = jsonDecode(response.body);
        if (result['success'] == true && result['data'] is List) {
          return List<Map<String, dynamic>>.from(result['data']);
        }
      } else {
        print("Error: Status ${response.statusCode}");
      }
    } catch (e) {
      print("fetchMasterData error: $e");
    }

    return [];
  }
}